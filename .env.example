# ── 三节课企业版对接参数 ────────────────────────────────
# 复制本文件为 .env 后填写。.env 已被 .gitignore 忽略，切勿提交。
SJK_DOMAIN=https://haoxue.b.sanjieke.cn
SJK_APP_ID=
SJK_APP_SECRET=
# 签名算法：1=MD5 2=HMAC-SHA1 3=HMAC-SHA256 4=HMAC-SHA384 5=HMAC-SHA512
# 文档标注 1/2 安全性不足，默认用 3。
SJK_SIGN_TYPE=3

# 演示用学员 openid（查节级完成状态时用；跳转本身不需要，用户已在平台登录）
DEMO_OPENID=haoxue24362792

# ── AI 规划器（任意 OpenAI 兼容端点）────────────────────
# 不填则自动降级为内置的规则版规划器，产品依然完整可跑。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ── 运行参数 ──────────────────────────────────────────
PORT=5173
# MOCK=1 强制离线演示模式（不访问三节课接口，用内置样例数据）
MOCK=0
